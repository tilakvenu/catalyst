# Copy this file to cloud/.env and fill in the values (cloud/.env is gitignored).
# Used only by scripts that run on your Mac (schema, seed, cheat tests).
# Back4App dashboard > your app "catalyst" > App Settings > Security & Keys.

# "Application ID"
PARSE_APP_ID=
# "JavaScript key" (the cheat tests sign in as normal users with this)
PARSE_JS_KEY=
# "Master Key" - full admin access. Never copy it into mobile/ or into a commit.
PARSE_MASTER_KEY=
# Parse API address, usually https://parseapi.back4app.com/
PARSE_SERVER_URL=

# Optional: only for npm run seed:demo (demo account for the Record tab).
# Password you choose, 8+ characters. Email defaults to demo@catalyst.example.
DEMO_EMAIL=
DEMO_PASSWORD=
