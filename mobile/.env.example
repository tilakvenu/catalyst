# Copy this file to mobile/.env and fill in the values (mobile/.env is gitignored).
# Back4App dashboard > your app "catalyst" > App Settings > Security & Keys.
# EXPO_PUBLIC_ values are bundled into the app, so only client-safe keys go here.
# NEVER put the Master Key in this file.

# "Application ID"
EXPO_PUBLIC_PARSE_APP_ID=
# "JavaScript key"
EXPO_PUBLIC_PARSE_JS_KEY=
# Parse API address, usually https://parseapi.back4app.com/
EXPO_PUBLIC_PARSE_SERVER_URL=
